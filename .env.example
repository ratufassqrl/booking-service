# Конфигурация развертывания. Скопируйте в .env и при необходимости поменяйте.

# Какой образ запускать.
# Первый запуск (образ собирается у вас на ноутбуке):
BOOKING_IMAGE=booking-service
IMAGE_TAG=local
# После настройки CI — образ из GitHub Container Registry, например:
# BOOKING_IMAGE=ghcr.io/ваш-логин/booking-service
# IMAGE_TAG=0.1.0

# База данных
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking
